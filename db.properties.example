# Copy this file to "db.properties" (same folder as pom.xml) and put your own values.
# db.properties is listed in .gitignore, so your password is never uploaded to GitHub.
#
# Alternative: set environment variables DB_URL, DB_USER, DB_PASSWORD
# (environment variables win over this file).

db.url=jdbc:mysql://localhost:3306/smart_classroom?useSSL=false&allowPublicKeyRetrieval=true&connectTimeout=5000
db.user=root
db.password=your_mysql_password_here
